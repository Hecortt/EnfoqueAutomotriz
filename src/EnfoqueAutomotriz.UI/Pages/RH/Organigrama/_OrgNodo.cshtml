@model EnfoqueAutomotriz.Domain.RH.OrganigramaNodo

<div class="flex flex-col items-center">
    <div class="card card-body !py-2 !px-4 text-center min-w-[160px] border-2 border-primary/30">
        <div class="w-10 h-10 mx-auto rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm mb-1">
            @(Model.NombreCompleto.Length > 0 ? Model.NombreCompleto[0].ToString().ToUpper() : "?")
        </div>
        <p class="text-xs font-semibold text-text-1 leading-tight">@Model.NombreCompleto</p>
        <p class="text-[10px] text-text-3">@Model.Puesto</p>
        @if (!string.IsNullOrEmpty(Model.Departamento))
        {
            <p class="text-[9px] text-text-3/70">@Model.Departamento</p>
        }
    </div>

    @if (Model.Subordinados.Count > 0)
    {
        <div class="w-px h-4 bg-border-ui"></div>
        <div class="flex gap-6 border-t border-border-ui pt-4">
            @foreach (var hijo in Model.Subordinados)
            {
                <partial name="_OrgNodo" model="hijo" />
            }
        </div>
    }
</div>
