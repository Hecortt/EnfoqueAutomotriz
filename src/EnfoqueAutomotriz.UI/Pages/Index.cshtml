@page
@model IndexModel
@using EnfoqueAutomotriz.UI.Pages.Shared
@{
    ViewData["Title"] = "Dashboard General";
}

<div class="mb-6">
    <h2 class="text-xl font-bold text-text-1">Dashboard General — Toda la empresa</h2>
    <p class="text-text-3 text-sm">Vista consolidada de @Model.Kpis?.SucursalesTotal sucursales.</p>
</div>

<partial name="_Ayuda" model="@(new AyudaModel {
    PaginaId = "dashboard-general",
    Titulo = "¿Qué muestra esta pantalla?",
    QueHace = "Vista consolidada de toda la empresa: ingresos, márgenes, órdenes activas y tendencias de los últimos 6 meses, sumando todas las sucursales.",
    Pasos = new List<PasoAyuda> {
        new(1, "Revisa las tarjetas superiores para un vistazo rápido de sucursales, empleados, órdenes activas, ingresos y margen del mes."),
        new(2, "La gráfica de tendencia compara ingresos vs. margen mes a mes para detectar tendencias."),
        new(3, "La dona de 'Órdenes por estatus' te dice cuántas unidades hay en cada etapa del proceso."),
        new(4, "Usa la tabla comparativa para ver qué sucursal está generando más ingresos y margen este mes.")
    },
    Conexiones = new List<ConexionAyuda> {
        new("Dashboard por Taller", "/Dashboard/PorSucursal", "building-2", "Detalle operativo de una sucursal específica"),
        new("Dashboard de Calidad", "/Dashboard/Calidad", "shield-check", "Ver qué órdenes se entregaron a tiempo"),
        new("Tablero Operativo", "/Dashboard/Operativo", "activity", "Ver las unidades activas en tiempo real")
    }
})" />

@if (Model.Kpis == null)
{
    <div class="alert alert-error">No se pudieron cargar los indicadores.</div>
}
else
{
    var k = Model.Kpis;
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-indigo-100">
                <i data-lucide="building-2" class="w-[18px] h-[18px] text-indigo-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-text-1" data-count-to="@k.SucursalesTotal">0</p>
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Sucursales</p>
            </div>
        </div>
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-blue-100">
                <i data-lucide="users" class="w-[18px] h-[18px] text-blue-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-text-1" data-count-to="@k.EmpleadosTotal">0</p>
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Empleados</p>
            </div>
        </div>
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-amber-100">
                <i data-lucide="wrench" class="w-[18px] h-[18px] text-amber-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-text-1" data-count-to="@k.OrdenesActivas">0</p>
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Órdenes activas</p>
            </div>
        </div>
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-emerald-100">
                <i data-lucide="banknote" class="w-[18px] h-[18px] text-emerald-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-text-1" data-count-to="@k.IngresosMes.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-prefix="$" data-decimals="0">$0</p>
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Ingresos del mes</p>
            </div>
        </div>
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-violet-100">
                <i data-lucide="trending-up" class="w-[18px] h-[18px] text-violet-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-emerald-600" data-count-to="@k.MargenMes.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-prefix="$" data-decimals="0">$0</p>
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Margen de utilidad</p>
                <p class="text-xs text-text-3 mt-0.5">@k.MargenPorcentaje% del ingreso</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-emerald-100">
                <i data-lucide="clock" class="w-[18px] h-[18px] text-emerald-600"></i>
            </div>
            <div>
                @if (k.EntregasATiempoPorcentaje.HasValue)
                {
                    <p class="text-2xl font-bold @(k.EntregasATiempoPorcentaje is >= 85 ? "text-emerald-600" : k.EntregasATiempoPorcentaje is >= 70 ? "text-amber-600" : "text-red-600")"
                       data-count-to="@k.EntregasATiempoPorcentaje.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">0%</p>
                }
                else
                {
                    <p class="text-2xl font-bold text-text-3">Sin datos</p>
                }
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Entregas a tiempo</p>
                <p class="text-xs text-text-3 mt-0.5">% de órdenes entregadas en o antes de la fecha comprometida</p>
            </div>
        </div>
        <div class="kpi-premium stagger-in">
            <div class="kpi-premium-icon bg-blue-100">
                <i data-lucide="timer" class="w-[18px] h-[18px] text-blue-600"></i>
            </div>
            <div>
                @if (k.TiempoPromedioReparacionHoras.HasValue)
                {
                    <p class="text-2xl font-bold text-text-1" data-count-to="@Math.Round(k.TiempoPromedioReparacionHoras.Value / 24, 1).ToString(System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix=" días">0 días</p>
                }
                else
                {
                    <p class="text-2xl font-bold text-text-3">Sin datos</p>
                }
                <p class="text-text-3 text-[11px] font-semibold uppercase tracking-wide">Tiempo promedio de reparación</p>
                <p class="text-xs text-text-3 mt-0.5">Desde recepción hasta entrega (@(k.TiempoPromedioReparacionHoras.HasValue ? $"{k.TiempoPromedioReparacionHoras.Value} hrs" : "—"))</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
        <div class="lg:col-span-2 chart-card stagger-in">
            <h3 class="font-semibold text-text-1 mb-3 flex items-center gap-2"><i data-lucide="line-chart" class="w-4 h-4 text-primary"></i> Tendencia — Ingresos vs. Margen (últimos 6 meses)</h3>
            <canvas id="chartTendencia" height="110"></canvas>
        </div>
        <div class="chart-card stagger-in">
            <h3 class="font-semibold text-text-1 mb-3 flex items-center gap-2"><i data-lucide="pie-chart" class="w-4 h-4 text-primary"></i> Órdenes por estatus</h3>
            <canvas id="chartEstados" height="220"></canvas>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="chart-card stagger-in">
            <h3 class="font-semibold text-text-1 mb-3 flex items-center gap-2"><i data-lucide="bar-chart-3" class="w-4 h-4 text-primary"></i> Ingresos por sucursal (mes actual)</h3>
            <canvas id="chartSucursales" height="220"></canvas>
        </div>
        <div class="card card-body stagger-in">
            <h3 class="font-semibold text-text-1 mb-3">Comparativo detallado</h3>
            <table class="w-full text-sm">
                <thead class="text-text-3 text-xs uppercase">
                    <tr><th class="text-left py-1.5">Sucursal</th><th class="text-right py-1.5">Órdenes</th><th class="text-right py-1.5">Ingresos</th><th class="text-right py-1.5">Margen</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in k.PorSucursal)
                    {
                        <tr class="border-t border-border-ui hover:bg-base/60 transition-colors">
                            <td class="py-1.5 font-medium">@s.Sucursal</td>
                            <td class="py-1.5 text-right">@s.Ordenes</td>
                            <td class="py-1.5 text-right">@s.Ingresos.ToString("C0")</td>
                            <td class="py-1.5 text-right text-emerald-600">@s.Margen.ToString("C0")</td>
                        </tr>
                    }
                    @if (!k.PorSucursal.Any())
                    {
                        <tr><td colspan="4" class="text-center py-6 text-text-3">Sin datos este mes.</td></tr>
                    }
                </tbody>
            </table>
            <div class="mt-4 pt-3 border-t border-border-ui flex justify-between text-sm">
                <span class="text-text-3">Clientes recurrentes</span>
                <span class="font-semibold">@k.ClientesRecurrentes / @k.ClientesTotal</span>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script>
        const tendencia = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(k.Tendencia, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const porEstado = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(k.PorEstado, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const porSucursal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(k.PorSucursal, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const T = window.ChartTheme;

        const ctxTendencia = document.getElementById('chartTendencia');
        new Chart(ctxTendencia, {
            type: 'line',
            data: {
                labels: tendencia.map(t => t.mes),
                datasets: [
                    T.lineDataset('Ingresos', tendencia.map(t => t.ingresos), T.colors.primary, ctxTendencia),
                    T.lineDataset('Margen', tendencia.map(t => t.margen), T.colors.emerald, ctxTendencia)
                ]
            },
            options: T.lineOptions()
        });

        const totalEstados = porEstado.reduce((a, e) => a + e.cantidad, 0);
        new Chart(document.getElementById('chartEstados'), {
            type: 'doughnut',
            data: {
                labels: porEstado.map(e => e.estado),
                datasets: [{
                    data: porEstado.map(e => e.cantidad),
                    backgroundColor: ['#94A3B8', '#F59E0B', '#FB923C', '#3B82F6', '#8B5CF6', '#10B981'],
                    hoverOffset: 10,
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: T.doughnutOptions({ plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 }, usePointStyle: true, pointStyle: 'circle' } } } }),
            plugins: [T.centerTextPlugin(totalEstados, 'Órdenes')]
        });

        new Chart(document.getElementById('chartSucursales'), {
            type: 'bar',
            data: {
                labels: porSucursal.map(s => s.sucursal),
                datasets: [{
                    label: 'Ingresos',
                    data: porSucursal.map(s => s.ingresos),
                    backgroundColor: T.colors.primary,
                    hoverBackgroundColor: '#4338CA',
                    maxBarThickness: 46
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(148,163,184,0.15)' } } } }
        });
    </script>
}
