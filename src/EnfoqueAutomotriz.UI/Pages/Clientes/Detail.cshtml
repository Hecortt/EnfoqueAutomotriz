@page "{id:guid}"
@model EnfoqueAutomotriz.UI.Pages.Clientes.DetailModel
@{
    ViewData["Title"] = Model.Cliente?.Nombre ?? "Cliente";
}

@if (Model.Cliente == null)
{
    <div class="alert alert-error">Cliente no encontrado.</div>
}
else
{
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-xl font-bold text-text-1">@Model.Cliente.Nombre</h2>
            <p class="text-text-3 text-sm">@Model.Cliente.Telefono · @Model.Cliente.Email</p>
        </div>
        <div>
            @if (Model.Cliente.NumeroVisitas <= 1)
            {
                <span class="badge bg-blue-100 text-blue-700">Cliente nuevo</span>
            }
            else
            {
                <span class="badge bg-emerald-100 text-emerald-700">Cliente recurrente · @Model.Cliente.NumeroVisitas visitas</span>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 card">
            <div class="card-body">
                <h3 class="font-semibold text-text-1 mb-3">Vehículos</h3>
                <table class="w-full text-sm">
                    <thead class="bg-base text-text-3 text-xs uppercase">
                        <tr>
                            <th class="text-left px-2.5 py-1.5">Vehículo</th>
                            <th class="text-left px-2.5 py-1.5">Placas</th>
                            <th class="text-left px-2.5 py-1.5">Km</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cliente.Vehiculos is { Count: > 0 })
                        {
                            foreach (var v in Model.Cliente.Vehiculos)
                            {
                                <tr class="border-t border-border-ui hover:bg-base/60 transition-colors">
                                    <td class="px-2.5 py-1.5">@v.Marca @v.Modelo @v.Anio</td>
                                    <td class="px-2.5 py-1.5">@v.Placas</td>
                                    <td class="px-2.5 py-1.5">@v.Kilometraje.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="px-3 py-4 text-center text-text-3">Sin vehículos registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3 class="font-semibold text-text-1 mb-3">Agregar vehículo</h3>
                <form method="post" class="space-y-3">
                    <input type="hidden" asp-for="Input.ClienteId" />
                    <div>
                        <label class="block text-xs font-medium text-text-2 mb-1">Marca</label>
                        <input asp-for="Input.Marca" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-text-2 mb-1">Modelo</label>
                        <input asp-for="Input.Modelo" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-medium text-text-2 mb-1">Año</label>
                            <input asp-for="Input.Anio" type="number" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-text-2 mb-1">Placas</label>
                            <input asp-for="Input.Placas" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-text-2 mb-1">Kilometraje</label>
                        <input asp-for="Input.Kilometraje" type="number" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                    </div>
                    <button type="submit" class="btn bg-primary text-white w-full">Agregar vehículo</button>
                </form>
            </div>
        </div>
    </div>
}
