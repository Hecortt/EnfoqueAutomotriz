@page
@model EnfoqueAutomotriz.UI.Pages.Clientes.IndexModel
@using EnfoqueAutomotriz.UI.Pages.Shared
@{
    ViewData["Title"] = "Clientes";
}

<div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-text-1">Clientes</h2>
</div>

<partial name="_Ayuda" model="@(new AyudaModel {
    PaginaId = "clientes-index",
    Titulo = "¿Qué muestra esta pantalla?",
    QueHace = "Directorio de clientes del taller, con su número de visitas y última fecha de servicio — útil para identificar clientes recurrentes.",
    Pasos = new List<PasoAyuda> {
        new(1, "Usa el buscador para encontrar un cliente por nombre o teléfono."),
        new(2, "Da clic en 'Ver' para abrir el historial de vehículos y órdenes de ese cliente."),
        new(3, "Registra un cliente nuevo con el formulario de la derecha antes de crear su primera orden de servicio.")
    },
    Conexiones = new List<ConexionAyuda> {
        new("Nueva Orden de Servicio", "/OrdenesServicio/Create", "wrench", "Registrar la recepción de un vehículo de este cliente")
    }
})" />

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 card">
        <div class="card-body">
            <form method="get" class="flex gap-2 mb-4">
                <input type="text" name="q" value="@Model.Query" placeholder="Buscar por nombre o teléfono..."
                       class="flex-1 h-10 px-3 rounded-lg border border-border-ui text-sm" />
                <button type="submit" class="btn bg-primary text-white">Buscar</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-base text-text-3 text-xs uppercase">
                        <tr>
                            <th class="text-left px-2.5 py-1.5">Nombre</th>
                            <th class="text-left px-2.5 py-1.5">Teléfono</th>
                            <th class="text-left px-2.5 py-1.5">Visitas</th>
                            <th class="text-left px-2.5 py-1.5">Última visita</th>
                            <th class="text-left px-2.5 py-1.5"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Clientes is { Count: > 0 })
                        {
                            foreach (var c in Model.Clientes)
                            {
                                <tr class="border-t border-border-ui hover:bg-base/60 transition-colors">
                                    <td class="px-2.5 py-1.5 font-medium text-text-1">@c.Nombre</td>
                                    <td class="px-2.5 py-1.5">@c.Telefono</td>
                                    <td class="px-2.5 py-1.5">
                                        @if (c.NumeroVisitas <= 1)
                                        {
                                            <span class="badge bg-blue-100 text-blue-700">Primera visita</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-emerald-100 text-emerald-700">@c.NumeroVisitas visitas</span>
                                        }
                                    </td>
                                    <td class="px-2.5 py-1.5 text-text-3">@(c.UltimaVisita?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="px-2.5 py-1.5">
                                        <a href="/Clientes/Detail/@c.Id" class="text-primary text-xs font-medium">Ver</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="px-3 py-6 text-center text-text-3">Sin clientes registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h3 class="font-semibold text-text-1 mb-3">Nuevo cliente</h3>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error mb-3">@Model.ErrorMessage</div>
            }
            <form method="post" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-text-2 mb-1">Nombre</label>
                    <input asp-for="Input.Nombre" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-text-2 mb-1">Teléfono</label>
                    <input asp-for="Input.Telefono" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-text-2 mb-1">Email</label>
                    <input asp-for="Input.Email" type="email" class="w-full h-9 px-3 rounded-lg border border-border-ui text-sm" />
                </div>
                <button type="submit" class="btn bg-primary text-white w-full">Guardar cliente</button>
            </form>
        </div>
    </div>
</div>
