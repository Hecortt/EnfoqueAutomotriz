@page "{id:guid}"
@model EnfoqueAutomotriz.UI.Pages.OrdenesServicio.DetailModel
@using EnfoqueAutomotriz.Domain.Ordenes
@using EnfoqueAutomotriz.UI.Pages.Shared
@{
    ViewData["Title"] = Model.Orden?.Folio ?? "Orden de Servicio";
}

@if (Model.Orden == null)
{
    <div class="alert alert-error">Orden no encontrada.</div>
}
else
{
    var o = Model.Orden;
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="text-xl font-bold text-text-1">@o.Folio</h2>
            <p class="text-text-3 text-sm">@o.Cliente?.Nombre · @o.Vehiculo?.Marca @o.Vehiculo?.Modelo @o.Vehiculo?.Anio (@o.Vehiculo?.Placas)</p>
        </div>
        <div class="flex gap-2">
            @if (o.Estado == EstadoOrdenServicio.Entregado)
            {
                <a href="/OrdenesServicio/Entrega/@o.TokenSeguimiento" target="_blank" class="btn bg-primary text-white">
                    <i data-lucide="party-popper" class="w-4 h-4"></i> Portal de Entrega
                </a>
            }
            <a href="/api/v1/ordenes-servicio/@o.Id/pdf" target="_blank" class="btn bg-white border border-border-ui">
                <i data-lucide="file-text" class="w-4 h-4"></i> Imprimir / PDF
            </a>
        </div>
    </div>

    <partial name="_Ayuda" model="@(new AyudaModel {
        PaginaId = "ordenes-servicio-detail",
        Titulo = "¿Qué puedo hacer aquí?",
        QueHace = "Expediente completo de la orden: estatus, cotización, conceptos, fotos, diagrama de daños, equipo de mecánicos y línea de tiempo.",
        Pasos = new List<PasoAyuda> {
            new(1, "Cambia el estatus de la orden con los botones de la parte superior conforme avanza el proceso."),
            new(2, "Agrega conceptos de mano de obra o refacciones — si es mano de obra, puedes indicar la especialidad."),
            new(3, "Marca daños preexistentes haciendo clic sobre el diagrama del vehículo (protege al taller ante reclamos)."),
            new(4, "Asigna uno o varios mecánicos en 'Equipo de mecánicos' — todos ellos sumarán en los reportes de desempeño."),
            new(5, "Cuando la cotización esté lista, usa 'Enviar cotización al cliente' para generar el link de aprobación del portal público."),
            new(6, "Al aprobar la cotización (o marcar la orden como Entregado), el sistema genera automáticamente la solicitud de refacciones a Almacén.")
        },
        Conexiones = new List<ConexionAyuda> {
            new("Solicitudes de Refacciones", "/Almacen/Solicitudes", "clipboard-list", "Ver el estatus de las refacciones pedidas para esta orden"),
            new("Desempeño Individual", "/Dashboard/Desempeno", "radar", "Ver cómo afecta esta orden al desempeño del mecánico asignado")
        }
    })" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 space-y-4">
            <!-- Estatus y acciones -->
            <div class="card card-body">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-text-1">Estatus: <span class="text-primary">@o.Estado</span></h3>
                </div>
                <form method="post" asp-page-handler="CambiarEstado" class="flex flex-wrap gap-2">
                    <input type="hidden" name="OrdenId" value="@o.Id" />
                    @foreach (var estado in Enum.GetValues<EstadoOrdenServicio>())
                    {
                        <button type="submit" name="NuevoEstado" value="@((int)estado)"
                                class="btn text-xs @(estado == o.Estado ? "bg-primary text-white" : "bg-white border border-border-ui")">
                            @estado
                        </button>
                    }
                </form>

                @if (o.EstadoCotizacion == EstadoCotizacion.NoAplica || o.EstadoCotizacion == EstadoCotizacion.Rechazada)
                {
                    <form method="post" asp-page-handler="EnviarCotizacion" class="mt-3">
                        <input type="hidden" name="OrdenId" value="@o.Id" />
                        <button type="submit" class="btn bg-amber-500 text-white text-sm">
                            <i data-lucide="send" class="w-4 h-4"></i> Enviar cotización al cliente
                        </button>
                    </form>
                }
                @if (o.EstadoCotizacion == EstadoCotizacion.Pendiente)
                {
                    <div class="mt-3 p-3 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-800">
                        Esperando aprobación del cliente. Comparte este link o el QR del PDF:
                        <a class="text-primary underline break-all" href="/Seguimiento/@o.TokenSeguimiento" target="_blank">/Seguimiento/@o.TokenSeguimiento</a>
                    </div>
                }
                @if (o.EstadoCotizacion == EstadoCotizacion.Aprobada)
                {
                    <div class="mt-3 p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-sm text-emerald-800">
                        ✓ Cotización aprobada por el cliente el @o.FechaAprobacionCotizacion?.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>

            <!-- Problema reportado -->
            <div class="card card-body">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="font-semibold text-text-1">Problema reportado</h3>
                    <button type="button" class="ia-btn" id="btnMejorarIADetail" title="Mejorar redacción con IA">
                        <span>✨</span><span>Mejorar con IA</span>
                    </button>
                </div>
                <form method="post" asp-page-handler="UpdateProblema" class="space-y-2">
                    <input type="hidden" name="OrdenId" value="@o.Id" />
                    <textarea name="ProblemaReportado" id="problemaReportadoDetail" rows="2" class="w-full px-3 py-2 rounded-lg border border-border-ui text-sm">@o.ProblemaReportado</textarea>
                    <button type="submit" class="btn bg-white border border-border-ui text-xs">Guardar cambios</button>
                </form>
            </div>

            <!-- Equipo de mecánicos -->
            <div class="card card-body">
                <h3 class="font-semibold text-text-1 mb-1">Equipo de mecánicos</h3>
                <p class="text-xs text-text-3 mb-3">Puede haber más de un mecánico atendiendo la misma orden. Se usa para medir carga de trabajo y calidad por operador.</p>

                <div id="chipsEquipo" data-orden-id="@o.Id" data-sucursal-id="@o.SucursalId" class="flex flex-wrap gap-2 mb-3">
                    <span class="text-xs text-text-3">Cargando equipo asignado...</span>
                </div>

                <div class="flex gap-2 items-end">
                    <div class="flex-1">
                        <label class="block text-[10px] text-text-3 mb-1">Agregar mecánico</label>
                        <select id="selectMecanico" class="w-full h-8 px-2 rounded border border-border-ui text-xs">
                            <option value="">Cargando disponibles...</option>
                        </select>
                    </div>
                    <button type="button" id="btnAgregarMecanico" class="btn bg-primary text-white text-xs h-8">Agregar</button>
                </div>
                <p id="equipoStatus" class="text-[11px] text-text-3 mt-2 h-4"></p>
            </div>

            <!-- Fechas y KPI de entrega -->
            <div class="card card-body">
                <h3 class="font-semibold text-text-1 mb-3">Fechas de servicio</h3>
                <div class="grid grid-cols-3 gap-3 text-sm mb-3">
                    <div>
                        <p class="text-[11px] text-text-3 uppercase">Ingreso</p>
                        <p class="font-medium">@o.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div>
                        <p class="text-[11px] text-text-3 uppercase">Salida programada</p>
                        <p class="font-medium">@(o.FechaEntregaProgramada?.ToString("dd/MM/yyyy HH:mm") ?? "No definida")</p>
                    </div>
                    <div>
                        <p class="text-[11px] text-text-3 uppercase">Salida real</p>
                        <p class="font-medium">@(o.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</p>
                    </div>
                </div>

                @if (o.EntregadoATiempo.HasValue)
                {
                    if (o.EntregadoATiempo.Value)
                    {
                        <div class="p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 mb-3">
                            ✓ Entregado a tiempo
                        </div>
                    }
                    else
                    {
                        <div class="p-2 rounded-lg bg-red-50 border border-red-200 text-xs text-red-800 mb-3">
                            ⚠ Entregado con retraso
                        </div>
                    }
                }

                <form method="post" asp-page-handler="SetFechaProgramada" class="flex gap-2 items-end">
                    <input type="hidden" name="OrdenId" value="@o.Id" />
                    <div class="flex-1">
                        <label class="block text-[10px] text-text-3">Fecha de entrega comprometida</label>
                        <input name="FechaEntregaProgramada" type="datetime-local"
                               value="@(o.FechaEntregaProgramada?.ToString("yyyy-MM-ddTHH:mm"))"
                               class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <button type="submit" class="btn bg-primary text-white text-xs h-8">Guardar</button>
                </form>
            </div>

            <!-- Diagrama de daños -->
            <div class="card card-body">
                <h3 class="font-semibold text-text-1 mb-1">Diagrama de daños / condiciones al ingreso</h3>
                <p class="text-xs text-text-3 mb-3">Da clic sobre el vehículo para marcar abolladuras, rayones u otros daños preexistentes.</p>

                <div class="flex flex-wrap gap-3 mb-3 text-[11px]">
                    <label class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#f59e0b"></span>Abolladura</label>
                    <label class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#3b82f6"></span>Rayón</label>
                    <label class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#ef4444"></span>Golpe</label>
                    <label class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#8b5cf6"></span>Rotura</label>
                    <label class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#6b7280"></span>Otro</label>
                </div>

                <select id="tipoMarcaDano" class="h-8 px-2 rounded border border-border-ui text-xs mb-2">
                    <option value="1">Abolladura</option>
                    <option value="2">Rayón</option>
                    <option value="3">Golpe</option>
                    <option value="4">Rotura</option>
                    <option value="5">Otro</option>
                </select>

                <div id="vehiculoDiagrama" data-orden-id="@o.Id" class="relative w-full max-w-md mx-auto bg-base rounded-lg border border-border-ui cursor-crosshair select-none" style="aspect-ratio: 2/3;">
                    <svg viewBox="0 0 200 300" class="w-full h-full pointer-events-none">
                        <rect x="30" y="20" width="140" height="260" rx="35" fill="#e5e7eb" stroke="#9ca3af" stroke-width="2" />
                        <rect x="45" y="45" width="110" height="55" rx="10" fill="#d1d5db" />
                        <rect x="45" y="200" width="110" height="55" rx="10" fill="#d1d5db" />
                        <circle cx="30" cy="70" r="10" fill="#4b5563" />
                        <circle cx="170" cy="70" r="10" fill="#4b5563" />
                        <circle cx="30" cy="230" r="10" fill="#4b5563" />
                        <circle cx="170" cy="230" r="10" fill="#4b5563" />
                        <text x="100" y="15" text-anchor="middle" font-size="11" fill="#6b7280">FRENTE</text>
                        <text x="100" y="296" text-anchor="middle" font-size="11" fill="#6b7280">ATRÁS</text>
                    </svg>

                    @foreach (var d in o.MarcasDano)
                    {
                        var color = d.Tipo switch
                        {
                            TipoMarcaDano.Abolladura => "#f59e0b",
                            TipoMarcaDano.Rayon => "#3b82f6",
                            TipoMarcaDano.Golpe => "#ef4444",
                            TipoMarcaDano.Rotura => "#8b5cf6",
                            _ => "#6b7280"
                        };
                        <button type="button" class="marca-dano absolute w-4 h-4 rounded-full border border-white shadow"
                                data-marca-id="@d.Id"
                                title="@d.Tipo — clic para eliminar"
                                style="left:@(d.X)%; top:@(d.Y)%; transform:translate(-50%,-50%); background:@color;"></button>
                    }
                </div>
                <p id="danoStatus" class="text-[11px] text-text-3 mt-2 h-4"></p>
            </div>

            <div class="card card-body">
                <h3 class="font-semibold text-text-1 mb-3">Conceptos (mano de obra y refacciones)</h3>
                <table class="w-full text-sm mb-3">
                    <thead class="text-text-3 text-xs uppercase">
                        <tr><th class="text-left py-1.5">Descripción</th><th class="text-left py-1.5">Tipo</th><th class="text-right py-1.5">Cant.</th><th class="text-right py-1.5">P. Unit.</th><th class="text-right py-1.5">Importe</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in o.Conceptos.Where(c => !c.IsDeleted))
                        {
                            <tr class="border-t border-border-ui hover:bg-base/60 transition-colors">
                                <td class="py-1.5">@c.Descripcion</td>
                                <td class="py-1.5">@c.Tipo</td>
                                <td class="py-1.5 text-right">@c.Cantidad</td>
                                <td class="py-1.5 text-right">@c.PrecioUnitario.ToString("C2")</td>
                                <td class="py-1.5 text-right">@c.Importe.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <form method="post" asp-page-handler="AddConcepto" class="grid grid-cols-7 gap-2 items-end">
                    <input type="hidden" name="OrdenId" value="@o.Id" />
                    <div class="col-span-2">
                        <label class="block text-[10px] text-text-3">Descripción</label>
                        <input name="Descripcion" class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <div>
                        <label class="block text-[10px] text-text-3">Tipo</label>
                        <select name="Tipo" id="tipoConcepto" class="w-full h-8 px-2 rounded border border-border-ui text-xs">
                            <option value="1">Mano de obra</option>
                            <option value="2">Refacción</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] text-text-3">Especialidad</label>
                        <select name="EspecialidadId" id="especialidadConcepto" class="w-full h-8 px-2 rounded border border-border-ui text-xs">
                            <option value="">—</option>
                            @foreach (var esp in Model.Especialidades)
                            {
                                <option value="@esp.Id">@esp.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] text-text-3">Cantidad</label>
                        <input name="Cantidad" type="number" step="0.01" value="1" class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <div>
                        <label class="block text-[10px] text-text-3">P. Unitario</label>
                        <input name="PrecioUnitario" type="number" step="0.01" class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <button type="submit" class="btn bg-primary text-white text-xs h-8">Agregar</button>
                </form>

                <div class="mt-4 flex justify-end">
                    <div class="w-56 text-sm space-y-1">
                        <div class="flex justify-between"><span>Subtotal</span><span>@o.Subtotal.ToString("C2")</span></div>
                        <div class="flex justify-between"><span>IVA</span><span>@o.Iva.ToString("C2")</span></div>
                        <div class="flex justify-between font-bold text-base border-t border-border-ui pt-1"><span>Total</span><span>@o.Total.ToString("C2")</span></div>
                    </div>
                </div>
            </div>

            <!-- Fotos -->
            <div class="card card-body">
                <h3 class="font-semibold text-text-1 mb-3">Fotos de avance (visibles para el cliente)</h3>
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-2 mb-3">
                    @foreach (var f in o.Fotos.OrderByDescending(f => f.CreatedAt))
                    {
                        <div class="rounded-lg overflow-hidden border border-border-ui">
                            <img src="@f.Url" class="w-full h-24 object-cover" />
                            <p class="text-[10px] p-1 text-text-3 truncate">@f.Nota</p>
                        </div>
                    }
                </div>
                <form method="post" asp-page-handler="AddFoto" class="grid grid-cols-4 gap-2 items-end">
                    <input type="hidden" name="OrdenId" value="@o.Id" />
                    <div class="col-span-2">
                        <label class="block text-[10px] text-text-3">URL de la foto</label>
                        <input name="Url" placeholder="https://..." class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <div>
                        <label class="block text-[10px] text-text-3">Nota</label>
                        <input name="Nota" class="w-full h-8 px-2 rounded border border-border-ui text-xs" />
                    </div>
                    <button type="submit" class="btn bg-primary text-white text-xs h-8">Subir foto</button>
                </form>
            </div>
        </div>

        <!-- Timeline -->
        <div class="card card-body">
            <h3 class="font-semibold text-text-1 mb-3">Línea de tiempo</h3>
            <div class="space-y-3">
                @foreach (var h in o.Historial.OrderByDescending(h => h.Fecha))
                {
                    <div class="border-l-2 border-primary pl-3">
                        <p class="text-xs font-semibold text-text-1">@h.Estado</p>
                        <p class="text-[11px] text-text-3">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                        @if (!string.IsNullOrEmpty(h.Comentario))
                        {
                            <p class="text-xs text-text-2">@h.Comentario</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // ── Concepto: la especialidad solo aplica a mano de obra ─────────────
        var tipoConceptoEl = document.getElementById('tipoConcepto');
        var especialidadEl = document.getElementById('especialidadConcepto');
        function toggleEspecialidad() {
            if (!tipoConceptoEl || !especialidadEl) return;
            especialidadEl.closest('div').style.display = tipoConceptoEl.value === '1' ? '' : 'none';
        }
        if (tipoConceptoEl) { tipoConceptoEl.addEventListener('change', toggleEspecialidad); toggleEspecialidad(); }

        // ── Diagrama de daños: clic para marcar (sin recargar la página) ─────
        var diagrama = document.getElementById('vehiculoDiagrama');
        var danoStatus = document.getElementById('danoStatus');
        var coloresDano = { 1: '#f59e0b', 2: '#3b82f6', 3: '#ef4444', 4: '#8b5cf6', 5: '#6b7280' };
        var nombresDano = { 1: 'Abolladura', 2: 'Rayón', 3: 'Golpe', 4: 'Rotura', 5: 'Otro' };

        function jwtHeader() {
            var jwt = document.querySelector('meta[name="jwt-token"]')?.content ?? '';
            return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + jwt };
        }

        // ── Equipo de mecánicos ───────────────────────────────────────────────
        var chipsEquipo = document.getElementById('chipsEquipo');
        var selectMecanico = document.getElementById('selectMecanico');
        var btnAgregarMecanico = document.getElementById('btnAgregarMecanico');
        var equipoStatus = document.getElementById('equipoStatus');
        var mecanicosAsignadosIds = [];

        function renderChipsEquipo(lista) {
            mecanicosAsignadosIds = lista.map(function (m) { return m.empleadoId; });
            if (lista.length === 0) {
                chipsEquipo.innerHTML = '<span class="text-xs text-text-3">Sin mecánicos asignados todavía.</span>';
                return;
            }
            chipsEquipo.innerHTML = '';
            lista.forEach(function (m) {
                var chip = document.createElement('span');
                chip.className = 'badge bg-blue-100 text-blue-700 inline-flex items-center gap-1.5';
                chip.innerHTML = '<span>' + m.nombre + (m.puesto ? ' · ' + m.puesto : '') + '</span>';
                var btnX = document.createElement('button');
                btnX.type = 'button';
                btnX.className = 'hover:text-red-600 font-bold';
                btnX.title = 'Quitar del equipo';
                btnX.textContent = '×';
                btnX.addEventListener('click', function () { eliminarMecanico(m.asignacionId); });
                chip.appendChild(btnX);
                chipsEquipo.appendChild(chip);
            });
        }

        function renderSelectDisponibles(disponibles) {
            var noAsignados = disponibles.filter(function (e) { return mecanicosAsignadosIds.indexOf(e.id) === -1; });
            if (noAsignados.length === 0) {
                selectMecanico.innerHTML = '<option value="">No hay más mecánicos disponibles</option>';
                return;
            }
            selectMecanico.innerHTML = '<option value="">Selecciona...</option>' +
                noAsignados.map(function (e) { return '<option value="' + e.id + '">' + e.nombre + ' — ' + e.puesto + '</option>'; }).join('');
        }

        var disponiblesCache = [];

        async function cargarEquipoMecanicos() {
            var ordenId = chipsEquipo.dataset.ordenId;
            var sucursalId = chipsEquipo.dataset.sucursalId;
            try {
                var [respAsignados, respDisponibles] = await Promise.all([
                    fetch('/api/v1/ordenes-servicio/' + ordenId + '/mecanicos', { headers: jwtHeader() }),
                    fetch('/api/v1/ordenes-servicio/mecanicos-disponibles?sucursalId=' + sucursalId, { headers: jwtHeader() })
                ]);
                var dataAsignados = await respAsignados.json();
                var dataDisponibles = await respDisponibles.json();
                renderChipsEquipo(dataAsignados.result || []);
                disponiblesCache = dataDisponibles.result || [];
                renderSelectDisponibles(disponiblesCache);
            } catch (err) {
                chipsEquipo.innerHTML = '<span class="text-xs text-red-600">Error al cargar el equipo.</span>';
            }
        }

        async function eliminarMecanico(asignacionId) {
            try {
                var resp = await fetch('/api/v1/ordenes-servicio/mecanicos/' + asignacionId, { method: 'DELETE', headers: jwtHeader() });
                if (!resp.ok) throw new Error('No se pudo quitar al mecánico.');
                equipoStatus.textContent = 'Mecánico removido del equipo.';
                setTimeout(function () { equipoStatus.textContent = ''; }, 2000);
                await cargarEquipoMecanicos();
            } catch (err) {
                equipoStatus.textContent = 'Error: ' + err.message;
            }
        }

        if (btnAgregarMecanico) {
            btnAgregarMecanico.addEventListener('click', async function () {
                var empleadoId = selectMecanico.value;
                if (!empleadoId) return;
                var ordenId = chipsEquipo.dataset.ordenId;
                equipoStatus.textContent = 'Agregando...';
                try {
                    var resp = await fetch('/api/v1/ordenes-servicio/' + ordenId + '/mecanicos', {
                        method: 'POST',
                        headers: jwtHeader(),
                        body: JSON.stringify({ empleadoId: empleadoId })
                    });
                    var data = await resp.json();
                    if (!resp.ok || !data.isSuccess) throw new Error((data.errorMessages && data.errorMessages[0]) || 'No se pudo agregar.');
                    equipoStatus.textContent = 'Mecánico agregado al equipo.';
                    setTimeout(function () { equipoStatus.textContent = ''; }, 2000);
                    await cargarEquipoMecanicos();
                } catch (err) {
                    equipoStatus.textContent = 'Error: ' + err.message;
                }
            });
        }

        if (chipsEquipo) cargarEquipoMecanicos();

        function crearMarcador(marca) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'marca-dano absolute w-4 h-4 rounded-full border border-white shadow';
            btn.dataset.marcaId = marca.id;
            btn.title = (nombresDano[marca.tipo] || 'Daño') + ' — clic para eliminar';
            btn.style.left = marca.x + '%';
            btn.style.top = marca.y + '%';
            btn.style.transform = 'translate(-50%,-50%)';
            btn.style.background = coloresDano[marca.tipo] || '#6b7280';
            btn.addEventListener('click', onClickMarcador);
            diagrama.appendChild(btn);
        }

        async function onClickMarcador(e) {
            e.stopPropagation();
            var btn = e.currentTarget;
            var marcaId = btn.dataset.marcaId;
            btn.disabled = true;
            try {
                var resp = await fetch('/api/v1/ordenes-servicio/danos/' + marcaId, {
                    method: 'DELETE',
                    headers: jwtHeader()
                });
                if (!resp.ok) throw new Error('No se pudo eliminar la marca.');
                btn.remove();
                if (danoStatus) { danoStatus.textContent = 'Marca eliminada.'; setTimeout(function () { danoStatus.textContent = ''; }, 2500); }
            } catch (err) {
                btn.disabled = false;
                if (danoStatus) danoStatus.textContent = 'Error: ' + err.message;
            }
        }

        document.querySelectorAll('.marca-dano').forEach(function (btn) {
            btn.addEventListener('click', onClickMarcador);
        });

        if (diagrama) {
            diagrama.addEventListener('click', async function (e) {
                if (e.target.closest('.marca-dano')) return; // clic en un marcador existente, ya manejado arriba
                var rect = diagrama.getBoundingClientRect();
                var x = ((e.clientX - rect.left) / rect.width) * 100;
                var y = ((e.clientY - rect.top) / rect.height) * 100;
                var tipo = parseInt(document.getElementById('tipoMarcaDano').value, 10);
                var ordenId = diagrama.dataset.ordenId;

                if (danoStatus) danoStatus.textContent = 'Guardando marca...';
                try {
                    var resp = await fetch('/api/v1/ordenes-servicio/' + ordenId + '/danos', {
                        method: 'POST',
                        headers: jwtHeader(),
                        body: JSON.stringify({ x: x, y: y, tipo: tipo, descripcion: null })
                    });
                    var data = await resp.json();
                    if (!resp.ok || !data.isSuccess) throw new Error((data.errorMessages && data.errorMessages[0]) || 'No se pudo guardar la marca.');

                    crearMarcador(data.result);
                    if (danoStatus) { danoStatus.textContent = 'Marca guardada.'; setTimeout(function () { danoStatus.textContent = ''; }, 2000); }
                } catch (err) {
                    if (danoStatus) danoStatus.textContent = 'Error: ' + err.message;
                }
            });
        }

        // ── Mejorar descripción con IA ───────────────────────────────────────
        var btnIA = document.getElementById('btnMejorarIADetail');
        if (btnIA) {
            btnIA.addEventListener('click', async function () {
                var btn = this;
                var textarea = document.getElementById('problemaReportadoDetail');
                var texto = textarea.value.trim();
                if (!texto) { textarea.focus(); return; }

                var originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.classList.add('ia-btn--loading');
                btn.innerHTML = '<span class="ia-spinner"></span><span>Procesando...</span>';

                try {
                    var jwt = document.querySelector('meta[name="jwt-token"]')?.content ?? '';
                    var resp = await fetch('/api/v1/ia/mejorar-descripcion-orden', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + jwt },
                        body: JSON.stringify({ descripcion: texto, vehiculo: '@o.Vehiculo?.Marca @o.Vehiculo?.Modelo' })
                    });
                    var data = await resp.json();
                    if (!resp.ok || !data.isSuccess) throw new Error((data.errorMessages && data.errorMessages[0]) || 'No se pudo mejorar el texto.');

                    textarea.value = data.result.descripcion;
                } catch (e) {
                    alert('Error de IA: ' + e.message);
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('ia-btn--loading');
                }
            });
        }
    </script>
}
